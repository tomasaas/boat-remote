# Caddy on the VPS: asks for the password and forwards everything to app.py on the boat,
# through the WireGuard tunnel. `make password` fills in the site, login and password hash
# and installs it as /etc/caddy/Caddyfile.
# The site is the domain (HTTPS: Caddy fetches and renews the certificate by itself),
# or :80 (plain HTTP on the IP) if no domain is set.
@SITE@ {
	basic_auth {
		@LOGIN@ @HASH@
	}
	reverse_proxy 10.88.0.2:8000

	# The boat doesn't answer: Pi off, no 4G, tunnel down, or app.py not running.
	handle_errors 502 503 504 {
		root * /var/www/boat
		rewrite * /offline.html
		file_server
	}
}
